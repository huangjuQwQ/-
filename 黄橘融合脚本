GeneralModules.LoadedThemeFromConfig = nil

GeneralModules.LoadSavedTheme = function()
    pcall(function()
        local path = "WindUI/" .. (Window.Folder or "MultiToolPanel") .. "/config/PageStyle.json"
        if isfile and readfile and isfile(path) then
            local raw = readfile(path)
            local data = game:GetService("HttpService"):JSONDecode(raw)
            local elements = data and data.__elements
            if elements and elements.Theme and elements.Theme.value then
                local name = elements.Theme.value
                if table.find(GeneralModules.AllThemes, name) then
                    WindUI:SetTheme(name)
                    GeneralModules.LoadedThemeFrom = name
                end
            end
        end
    end)
    return GeneralModules.LoadedThemeFrom or "Dark"
end

GeneralModules.ApplyTheme = function(themeName)
    if not table.find(GeneralModules.AllThemes, themeName) then
        return false
    end
    local ok, err = pcall(function()
        WindUI:SetTheme(themeName)
    end)
    if ok then
        -- 手动保存到 JSON
        local data = {__version = 1.2, __elements = {Theme = {__type = "Dropdown", value = themeName}}, __autoload = true, __custom = {Theme = themeName}}
        pcall(function()
            local path = "WindUI/" .. (Window.Folder or "MultiPanel") .. "/config/"
            if not isfolder(path) then makefolder(path) end
            writefile(path .. "PageStyle.json", game:GetService("HttpService"):JSONEncode(data))
        end)
        GeneralModules.LoadedThemeFromTheme = themeName
        NotifyWithIcon("✅ 主题已切换", themeName, "check", 2)
        return true
    else
        NotifyWithIcon("❌ 切换失败", tostring(err):sub(1, 40), "x", 3)
        return false
    end
end

