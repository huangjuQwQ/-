            end
        end)

        -- 通用创建开关函数（内部使用，可直接访问 MainFrame）
        local function CreateToggle(yPos, name, defaultState, callback)
            -- 开关背景
            local ToggleBg = Instance.new("Frame")
            ToggleBg.Size = UDim2.new(0, 30, 0, 15)
            ToggleBg.Position = UDim2.new(0.7, 0, 0, yPos)
            ToggleBg.BackgroundColor3 = defaultState and Color3.fromRGB(0, 140, 0) or Color3.fromRGB(140, 0, 0)
            ToggleBg.BorderSizePixel = 0
            ToggleBg.Parent = MainFrame

            -- 开关文字
            local ToggleText = Instance.new("TextLabel")
            ToggleText.Size = UDim2.new(0, 30, 0, 15)
            ToggleText.Position = UDim2.new(0.7, 0, 0, yPos)
            ToggleText.BackgroundTransparency = 1
            ToggleText.Text = defaultState and "ON" or "OFF"
            ToggleText.TextColor3 = Color3.new(1, 1, 1)
            ToggleText.TextSize = 9
            ToggleText.Font = Enum.Font.SourceSansBold
            ToggleText.Parent = MainFrame

            -- 开关标签
            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.65, 0, 0, 15)
            Label.Position = UDim2.new(0, 5, 0, yPos)
            Label.BackgroundTransparency = 1
            Label.Text = name
            Label.TextColor3 = Color3.new(1, 1, 1)
            Label.TextSize = 10
            Label.Font = Enum.Font.SourceSans
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = MainFrame

            -- 点击区域
            local ClickArea = Instance.new("TextButton")
            ClickArea.Size = UDim2.new(0, 30, 0, 15)
            ClickArea.Position = UDim2.new(0.7, 0, 0, yPos)
            ClickArea.BackgroundTransparency = 1
            ClickArea.Text = ""
            ClickArea.Parent = MainFrame

            local state = defaultState
            ClickArea.MouseButton1Down:Connect(function()
                state = not state
                ToggleBg.BackgroundColor3 = state and Color3.fromRGB(0, 140, 0) or Color3.fromRGB(140, 0, 0)
                ToggleText.Text = state and "ON" or "OFF"
                callback(state)
            end)
        end

        -- 创建3个开关（位置适配超小面板）
        CreateToggle(22, "All", _G.EnableAllESP, function(state)
            _G.EnableAllESP = state
        end)

        CreateToggle(42, "Scrap", _G.ScrapESP, function(state)
            _G.ScrapESP = state
        end)

        CreateToggle(62, "Flare", _G.FlareGunESP, function(state)
            _G.FlareGunESP = state
            if not state then
                local fg = Workspace:FindFirstChild("FlareGunPickUp")
                if fg and fg:FindFirstChild("FlareGunChams") then
                    fg.FlareGunChams:Destroy()
                end
            end
        end)

        return ScreenGui
    end

    -- 首次创建 UI
    CreateESPUI()

    --==============================
    -- ESP 核心逻辑（优化性能，避免重复创建）
    --==============================
    -- 存储已创建的 ESP 文本，避免内存泄漏
    local ScrapESPList = {}
    local FlareESP = nil

    RunService.Heartbeat:Connect(function()
        -- 【关键修复】检测 UI 是否被游戏重置清除，若消失则重建
        local currentPG = Player:FindFirstChild("PlayerGui")
        if currentPG and not currentPG:FindFirstChild("ESP_Control") then
            CreateESPUI()
            -- 重建后直接返回，下一帧再执行 ESP 刷新，避免状态错乱
            return
        end

        if not _G.EnableAllESP then
            -- 总开关关闭，隐藏所有 ESP
            if FlareESP then FlareESP.Visible = false end
            for _, esp in pairs(ScrapESPList) do
                esp.Visible = false
            end
            return
        end

        -- 1. Scrap ESP + Chams
        if _G.ScrapESP then
            local ScrapSpawns = Workspace:FindFirstChild("Filter") and Workspace.Filter:FindFirstChild("ScrapSpawns")
            if ScrapSpawns then
                for _, v in pairs(ScrapSpawns:GetDescendants()) do
                    if v.Name == "Scrap" and not ScrapESPList[v] then
                        local esp = Drawing.new("Text")
                        esp.Center = true
                        esp.Outline = false
                        esp.Color = Color3.fromRGB(77, 35, 1)
                        esp.Size = 11
                        esp.Font = 2
                        esp.Visible = false
                        ScrapESPList[v] = esp

                        local chams = Instance.new("Highlight")
                        chams.Parent = v
                        chams.Adornee = v
                        chams.FillColor = Color3.fromRGB(77, 35, 1)
                        chams.FillTransparency = 0
                        chams.OutlineTransparency = 0
                        chams.OutlineColor = Color3.fromRGB(170, 170, 170)
                        chams.Name = "ScrapChams"

                        RunService.Heartbeat:Connect(function()
                            if not _G.EnableAllESP or not _G.ScrapESP or not v.Parent then
                                esp.Visible = false
                                if chams then chams:Destroy() end
                                ScrapESPList[v] = nil
                                return
                            end
                            local cam = Workspace.CurrentCamera
                            local Vec3, OnScreen = cam:WorldToViewportPoint(v.Position)
                            esp.Visible = OnScreen
                            if OnScreen then
                                esp.Position = Vector2.new(Vec3.X, Vec3.Y)
                                esp.Text = "Scrap " .. v.Parent.PointsVal.Value .. " Lv" .. v.Parent.LevelVal.Value
                            end
                        end)
                    end
                end
            end
        end

        -- 2. Flare Gun ESP + Chams
        if _G.FlareGunESP then
            local fg = Workspace:FindFirstChild("FlareGunPickUp")
            if fg and fg:FindFirstChild("FlareGun") and not FlareESP then
                FlareESP = Drawing.new("Text")
                FlareESP.Text = "Flare Gun"
                FlareESP.Color = Color3.fromRGB(0, 225, 255)
                FlareESP.Outline = false
                FlareESP.Center = true
                FlareESP.Font = 2
                FlareESP.Size = 11
                FlareESP.Visible = false

                local chams = Instance.new("Highlight")
                chams.Parent = fg
                chams.Adornee = fg
                chams.FillColor = Color3.fromRGB(255, 0, 0)
                chams.FillTransparency = 0.3
                chams.OutlineTransparency = 0.8
                chams.OutlineColor = Color3.fromRGB(170, 170, 170)
                chams.Name = "FlareGunChams"

                RunService.Heartbeat:Connect(function()
                    if not _G.EnableAllESP or not _G.FlareGunESP or not fg:FindFirstChild("FlareGun") then
                        FlareESP.Visible = false
                        if chams then chams:Destroy() end
                        FlareESP = nil
                        return
                    end
                    local cam = Workspace.CurrentCamera
                    local Pos, OnScreen = cam:WorldToViewportPoint(fg.FlareGun.Position)
                    FlareESP.Visible = OnScreen
                    if OnScreen then
                        FlareESP.Position = Vector2.new(Pos.X, Pos.Y)
                    end
                end)
            end
        end
    end)
end

