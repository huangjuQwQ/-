-- 移除单个物品的标记
local function removeMarker(item)
	if not item then return end
	local h = item:FindFirstChild("MarkerHighlight")
	if h then h:Destroy() end
	local b = item:FindFirstChild("MarkerName")
	if b then b:Destroy() end
end

-- 扫描父容器下所有匹配名称的物品，执行 addOrRemove 函数（传入物品，true=添加，false=移除）
local function processAll(enable)
	local parent = getParent()
	for _, child in ipairs(parent:GetDescendants()) do
		if child.Name == targetName then
			if enable then
				addMarker(child)
			else
				removeMarker(child)
			end
		end
	end
end

-- 监听新物品出现
local function watchNew(parent)
	parent.DescendantAdded:Connect(function(child)
		if child.Name == targetName then
			if markerEnabled then
				addMarker(child)
			end
		end
	end)
end

-- 切换开关时更新所有已有物品
local function refreshAll()
	local parent = getParent()
	processAll(markerEnabled)
end

