-- ========== 环境回声 ==========
ReverbEnabled = false

ApplyReverb = function(sound)
    if not sound or not sound.Parent then return end
    -- 先清理旧回声效果（避免重复添加）
    pcall(function()
        for _, effect in ipairs(sound:GetChildren()) do
            if effect:IsA("ReverbSoundEffect") then
                effect:Destroy()
            end
        end
    end)
    -- 创建干净的空间回声：原声清晰为主，回声若有若无作氛围
    pcall(function()
        local r = Instance.new("ReverbSoundEffect")
        r.DecayTime = 1.8        -- 衰减适中，模拟小型演奏厅
        r.Density = 0.5          -- 较轻的回声厚度，不浑浊
        r.Diffusion = 0.85       -- 扩散均匀，自然平滑
        r.DryLevel = -1          -- 原声几乎不衰减，保持清晰
        r.WetLevel = -4          -- 回声音量压低，只作空间氛围
        r.Parent = sound
    end)
end

RemoveReverb = function(sound)
    if not sound or not sound.Parent then return end
    pcall(function()
        for _, effect in ipairs(sound:GetChildren()) do
            if effect:IsA("ReverbSoundEffect") then
                effect:Destroy()
            end
        end
    end)
end

ToggleReverb = function(enabled)
    ReverbEnabled = enabled
    if CurrentMusic and CurrentMusic.Parent then
        if enabled then
            ApplyReverb(CurrentMusic)
            Notify("🔊 环境回声", "已开启回声效果", 2)
        else
            RemoveReverb(CurrentMusic)
            Notify("🔊 环境回声", "已关闭回声效果", 2)
        end
    end
end

-- ========== 核心播放函数 ==========

PlayMusicById = function(id)
    -- 先停止当前播放
    if CurrentMusic then
        pcall(function()
            CurrentMusic:Stop()
            CurrentMusic:Destroy()
        end)
        CurrentMusic = nil
    end

    local success, sound = pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = 1
        s.Parent = game.Workspace
        s:Play()
        return s
    end)

    if success and sound then
        CurrentMusic = sound

        -- 自动应用环境回声（如果已开启）
        if ReverbEnabled then
            ApplyReverb(sound)
        end

        Notify("🎵 正在播放", "音乐ID: " .. id, 2)
    else
        Notify("❌ 播放失败", "ID无效或资源不存在: " .. tostring(err or ""):sub(1, 40), 3)
    end

    return success
end

PlayMusicByName = function(name)
    for _, item in ipairs(MusicPlaylist) do
        if item.Name == name then
            PlayMusicById(item.Id)
            return true
        end
    end
    Notify("❌ 未找到", "预设音乐: " .. name, 2)
    return false
end

StopMusic = function()
    if CurrentMusic then
        pcall(function()
            CurrentMusic:Stop()
            CurrentMusic:Destroy()
        end)
        CurrentMusic = nil
        Notify("⏹️ 已停止", "音乐播放已停止", 2)
    else
        Notify("⏹️ 提示", "当前没有正在播放的音乐", 2)
    end
end

PlayUserInputId = function(inputText, isInit)
    -- 初始化加载时静默跳过
    if isInit then return end
    local id = (inputText or ""):gsub("%s+", "")
    if id == "" or not tonumber(id) then
        Notify("⚠️ 无效ID", "请输入纯数字的音乐ID，例如: 792323017", 3)
        return false
    end
    local success = PlayMusicById(id)
    if success then
        Notify("✅ 播放成功", "已播放ID: " .. id, 2)
    end
    return success
end

