            YLabel.Text = labelInfo.value .. "毫秒"
            YLabel.TextSize = 14
            YLabel.TextXAlignment = Enum.TextXAlignment.Right
            YLabel.Parent = YAxisFrame
        end
        local Plot = Instance.new("Frame")
        Plot.Name = "PlotArea"
        Plot.Size = UDim2.new(1, -65, 1, -30)
        Plot.Position = UDim2.new(0, 65, 0, 28)
        Plot.BackgroundTransparency = 1
        Plot.ClipsDescendants = true
        Plot.Parent = Container
        local PingData = {}
        local LineSegments = {}
        local STEP_X = GRAPH_WIDTH / (MAX_DATA_POINTS - 1)
        local LINE_THICKNESS = 2
        for i = 1, MAX_DATA_POINTS - 1 do
            local line = Instance.new("Frame")
            line.Name = "Line"..i
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BorderSizePixel = 0
            line.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
            line.Size = UDim2.fromOffset(1, LINE_THICKNESS)
            line.Position = UDim2.fromOffset((i - 1) * STEP_X, GRAPH_HEIGHT / 2)
            line.Parent = Plot
            table.insert(LineSegments, line)
        end
        local function mapPingToY(ping)
            local clampedPing = math.clamp(ping, 0, MAX_PING_SCALE)
            local normalized = 1 - (clampedPing / MAX_PING_SCALE)
            return normalized * GRAPH_HEIGHT
        end
        local function updateText()
            local currentPing = getClientSidePing()
            currentPing = math.floor(currentPing + 0.5)
            PingLabel.Text = string.format("延迟:%d毫秒", currentPing)
            FPSLabel.Text = string.format("帧率:%d", math.floor(currentFPS + 0.5))
        end
        local function updateGraph()
            local currentPing = getClientSidePing()
            currentPing = math.floor(currentPing + 0.5)
            table.insert(PingData, currentPing)
            if #PingData > MAX_DATA_POINTS then table.remove(PingData, 1) end
            while #PingData < MAX_DATA_POINTS do table.insert(PingData, 1, 0) end
            for i = 1, #LineSegments do
                local v1 = PingData[i]
                local v2 = PingData[i + 1]
                if v1 and v2 then
                    local x1 = (i - 1) * STEP_X
                    local y1 = mapPingToY(v1)
                    local x2 = i * STEP_X
                    local y2 = mapPingToY(v2)
                    local mx = (x1 + x2) / 2
                    local my = (y1 + y2) / 2
                    local dx = x2 - x1
                    local dy = y2 - y1
                    local length = math.sqrt(dx^2 + dy^2)
                    local angle = math.deg(math.atan2(dy, dx))
                    local line = LineSegments[i]
                    line.Position = UDim2.fromOffset(mx, my)
                    line.Size = UDim2.fromOffset(length + 2, LINE_THICKNESS)
                    line.Rotation = angle
                end
            end
        end
        local isDragging = false
        local dragStartPos = nil
        local startContainerPos = nil
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                dragStartPos = input.Position
                startContainerPos = Container.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then isDragging = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStartPos
                Container.Position = UDim2.new(startContainerPos.X.Scale, startContainerPos.X.Offset + delta.X, startContainerPos.Y.Scale, startContainerPos.Y.Offset + delta.Y)
            end
        end)
        CloseButton.MouseButton1Click:Connect(function() Container.Visible = false end)
        RunService.Heartbeat:Connect(function() if Container.Visible then updateText() end end)
        task.spawn(function() while true do if Container.Visible then updateGraph() end task.wait(UPDATE_INTERVAL_GRAPH) end end)
    ]])()
    Notify("✅ 启动成功", "Ping/FPS监控已加载", 2)
end

