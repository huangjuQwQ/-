GeneralModules.PlayerWatcher = (function()
    local Module = {}
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local localPlayer = Players.LocalPlayer
    local camera = Workspace.CurrentCamera

    -- 状态
    local isWatching = false
    local watchTarget = nil
    local renderBindName = "WatcherHideLocalChar"
    local heartbeatConn = nil
    local targetCharAddedConn = nil
    local playerRemovingConn = nil

    -- UI 组件引用（由外部创建后注入）
    local UI = {
        PlayerInput = nil,      -- Input 组件
        StartBtn = nil,         -- Button 组件
        StopBtn = nil,          -- Button 组件
        StatusLabel = nil,      -- Paragraph/Label 组件
        PlayerDropdown = nil,   -- Dropdown 组件
        MainToggle = nil,       -- Toggle 组件
    }

    -- 注入 UI 引用
    function Module.BindUI(refs)
        for k, v in pairs(refs) do UI[k] = v end
    end

    -- 更新状态文本
    local function SetStatus(text)
        if UI.StatusLabel and UI.StatusLabel.SetDesc then
            UI.StatusLabel:SetDesc(text)
        end
    end

    -- 更新下拉列表
    local function RefreshPlayerList()
        if not UI.PlayerDropdown then return end
        local players = Players:GetPlayers()
        table.sort(players, function(a, b) return a.Name:lower() < b.Name:lower() end)
        local names = {}
        for _, p in ipairs(players) do
            if p ~= localPlayer then table.insert(names, p.Name) end
        end
        UI.PlayerDropdown:Refresh(names, false)
    end

    -- 隐藏/显示本地角色
    local function SetLocalCharacterInvisible(char, invisible)
        if not char then return end
        local value = invisible and 1 or 0
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") then
                obj.LocalTransparencyModifier = value
            end
        end
    end

    -- 停止观战（核心清理）
    local function StopFollowing()
        if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
        if targetCharAddedConn then targetCharAddedConn:Disconnect(); targetCharAddedConn = nil end
        if playerRemovingConn then playerRemovingConn:Disconnect(); playerRemovingConn = nil end
        pcall(function() RunService:UnbindFromRenderStep(renderBindName) end)

        local char = localPlayer.Character
        if char then SetLocalCharacterInvisible(char, false) end
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then camera.CameraSubject = humanoid end
        end
        camera.CameraType = Enum.CameraType.Custom

        isWatching = false
        watchTarget = nil
        SetStatus("状态：已停止观战")
    end

    -- 开始观战
    local function StartFollowing(playerName)
        StopFollowing()

        local targetPlayer = Players:FindFirstChild(playerName)
        if not targetPlayer then
            SetStatus("状态：未找到该玩家！")
            return
        end

        isWatching = true
        watchTarget = targetPlayer

        -- 绑定摄像机到目标
        local function AttachCamera()
            local targetChar = targetPlayer.Character
            if not targetChar then return false end
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return false end

            camera.CameraType = Enum.CameraType.Custom
            if targetHumanoid then
                camera.CameraSubject = targetHumanoid
            else
                camera.CameraSubject = targetRoot
            end
            return true
        end

        if not AttachCamera() then
            SetStatus("状态：等待目标角色加载...")
        else
            SetStatus("状态：正在观战 " .. targetPlayer.Name)
        end

        -- 每帧隐藏本地角色
        pcall(function() RunService:UnbindFromRenderStep(renderBindName) end)
        RunService:BindToRenderStep(renderBindName, Enum.RenderPriority.Camera.Value + 1, function()
            if not isWatching then return end
            local char = localPlayer.Character
            if char then SetLocalCharacterInvisible(char, true) end
        end)

        -- Heartbeat：校验目标 + 保持 CameraSubject + 流式加载请求
        local lastStreamRequest = 0
        local STREAM_INTERVAL = 1.5

        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not isWatching or not watchTarget or not watchTarget.Parent then
                StopFollowing()
                SetStatus("状态：目标已离开游戏")
                return
            end

            local targetChar = watchTarget.Character
            if not targetChar then return end

            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            if not targetRoot then return end

            -- 确保摄像机模式
            if camera.CameraType ~= Enum.CameraType.Custom then
                camera.CameraType = Enum.CameraType.Custom
            end

            -- 目标重生后重新绑定 CameraSubject
            if targetHumanoid and camera.CameraSubject ~= targetHumanoid then
                camera.CameraSubject = targetHumanoid
            elseif not targetHumanoid and camera.CameraSubject ~= targetRoot then
                camera.CameraSubject = targetRoot
            end

            -- 请求目标周围区块加载
            local now = os.clock()
            if now - lastStreamRequest >= STREAM_INTERVAL then
                lastStreamRequest = now
                if Workspace.StreamingEnabled then
                    task.spawn(function()
                        pcall(function()
