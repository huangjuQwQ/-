    end
end

local WindUI = loadstring(WindUI_Source)()

-- ==================== 通用工具函数 ====================
-- 统一通知函数：全部使用 WindUI 内置 Notification 组件
-- 用法：WindUI:Notify({ Title = "标题", Content = "内容", Icon = "图标名", Duration = 秒 })
-- 图标可直接传入 WindUI 支持的图标名（如 "check", "x", "triangle-alert", "info", "zap" 等）
-- 或使用 "lucide:" 前缀 (如 "lucide:check")、sfsymbols (如 "sfsymbols:checkmark")

local function setClipboard(str)
    if setclipboard then
        setclipboard(str)
    elseif game.SetClipboard then
        game:SetClipboard(str)
    else
        warn("剪贴板不可用")
    end
end

-- 便捷封装：保持与旧 Notify 类似的调用习惯
local function Notify(title, text, duration)
    pcall(function()
        WindUI:Notify({
            Title = title,
            Content = text,
            Duration = duration or 2,
        })
    end)
end

-- 带图标的便捷通知
local function NotifyWithIcon(title, text, icon, duration)
    pcall(function()
        WindUI:Notify({
            Title = title,
            Content = text,
            Icon = icon,
            Duration = duration or 2,
        })
    end)
end

